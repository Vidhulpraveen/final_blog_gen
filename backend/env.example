# Blu Blog Gen Backend - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application settings
DEBUG=true
HOST=0.0.0.0
PORT=8000
NODE_ENV=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL (required)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon key (required for basic operations)
SUPABASE_ANON_KEY=your_anon_key_here

# Your Supabase service role key (optional, for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# AI SERVICE KEYS (Optional - for blog generation features)
# =============================================================================

# OpenAI API Key (GPT-4, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Gemini 1.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Note: At least one AI service key is recommended for blog generation
# OpenAI is prioritized, then Gemini, then mock data fallback

# =============================================================================
# WORDPRESS INTEGRATION
# =============================================================================

# WordPress API credentials (optional)
WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json/wp/v2
WORDPRESS_USERNAME=your_wordpress_username
WORDPRESS_PASSWORD=your_wordpress_application_password

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
ENABLE_AI_GENERATION=true
ENABLE_WORDPRESS_INTEGRATION=true
ENABLE_ANALYTICS=true

# =============================================================================
# NOTES
# =============================================================================

# 1. NEVER commit .env to version control
# 2. Keep your API keys secure
# 3. Use different keys for development/staging/production
# 4. Rotate keys regularly for security
# 5. The backend requires SUPABASE_SERVICE_ROLE_KEY (not the anon key)

# =============================================================================
# QUICK START
# =============================================================================

# To get started:
# 1. Copy this file: cp env.example .env
# 2. Fill in your Supabase credentials
# 3. Add any AI service API keys you need
# 4. Start the backend: python -m uvicorn app.main:app --reload
